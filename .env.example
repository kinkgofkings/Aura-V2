# Aura Social & Sanctuary Environment Configuration
# Copy this file to .env and provide your secret credentials.
# The .env file is git-ignored to prevent exposing tokens on GitHub.

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_DATABASE_ID=YOUR_FIREBASE_DATABASE_ID

# Server-Side APIs (Never exposed to the browser or public view)
PEXELS_API_KEY=YOUR_PEXELS_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
JWT_SECRET=your-random-jwt-secret-string

# Web Push Notifications
# Set these in production and keep them stable. If they are empty, the server
# stores generated keys in data/auth.db. A new key pair invalidates every phone.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@webcraftstudio.cloud

# TURN relay for audio and video across mobile networks.
# Use a static username, or leave those blank and set TURN_SECRET so the
# server mints a short-lived Coturn REST password (HMAC-SHA1).
# Example: TURN_URLS=turn:webcraftstudio.cloud:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
TURN_TTL_SECONDS=43200
